{
  "manifest_version": 3,
  "name": "Subject Line Checker",
  "version": "1.0",
  "description": "Check subject line & preview text truncation across Gmail, Apple Mail, Outlook and Yahoo before you send.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
